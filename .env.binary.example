# 环境变量模板 —— binary 模式（docker-compose.binary.yml）
# 容器内【不编译】，只拷宿主机上已交叉编译好的 Linux 二进制。
#
# ── 使用前必须先编译 ──────────────────────────────────────────────────────
# 在项目根目录（开发机，Windows/macOS/Linux 都行）：
#
#     # x86_64 服务器
#     CGO_ENABLED=0 GOOS=linux GOARCH=amd64 \
#       go build -trimpath -ldflags="-s -w" \
#       -o dist/fantwo-core-linux-amd64 ./cmd/server
#
#     # ARM64 服务器（AWS Graviton / 阿里云倚天 / 华为鲲鹏）
#     CGO_ENABLED=0 GOOS=linux GOARCH=arm64 \
#       go build -trimpath -ldflags="-s -w" \
#       -o dist/fantwo-core-linux-arm64 ./cmd/server
#
# 然后把 dist/ 一起传上服务器。GOARCH 必须与服务器一致，
# 否则容器起来就报 "exec format error"。查服务器架构：uname -m
#   x86_64 → amd64      aarch64 → arm64
#
# ── 用法 ──────────────────────────────────────────────────────────────────
#     cp .env.binary.example .env
#     vim .env                                  # 至少改 JWT_SECRET / POSTGRES_PASSWORD
#     docker compose -f docker-compose.binary.yml up -d --build
#     curl http://127.0.0.1:8079/health
#
# 与 .env.build.example 的区别只有构建方式（本文件走 from-binary，约 5 秒），
# 其余运行时变量完全一致。
#
# ══════════════════════════════════════════════════════════════════════════
# 本编排只跑一个服务 fantwo-core；PostgreSQL / Redis / Elasticsearch
# 都在【别的容器】里（1panel 装的或独立部署），这里只负责连过去。
# ══════════════════════════════════════════════════════════════════════════
#
# ┌─ 容器间怎么填地址（最容易错的一节）──────────────────────────────────┐
# │ 容器里的 127.0.0.1 = 容器自己，永远连不到别的容器。                     │
# │                                                                       │
# │  PG/Redis/ES 在别的容器，且与本服务同一 Docker 网络                     │
# │    → 填【容器名】：1Panel-postgresql-Oyls / 1Panel-redis-Ohyl          │
# │                                                                       │
# │  PG/Redis/ES 通过宿主机端口映射暴露                                     │
# │    → 填 host.docker.internal                                          │
# │                                                                       │
# │  在别的机器上 → 填那台机器的 IP                                        │
# └───────────────────────────────────────────────────────────────────────┘
#
# ┌─ 配置改了什么时候生效 ────────────────────────────────────────────────┐
# │ 业务配置（上传上限/水印/搜索开关/审核…）已是「DB config 表优先」        │
# │   PATCH /api/v1/config   body: [{"key":"...","value":"..."}]           │
# │   生效：下一个请求（≤1 秒），【不用重启】                              │
# │                                                                       │
# │ 仅 env 的项（存储驱动/S3 七项/DB/Redis/JWT/端口）→ 重建容器            │
# │ 详见 docs/08-配置迁移运维手册.md                                       │
# └───────────────────────────────────────────────────────────────────────┘


# ==========================================================================
# 一、二进制路径（binary 模式专有）
# ==========================================================================

# 相对项目根目录的二进制路径。
# amd64 服务器：dist/fantwo-core-linux-amd64
# arm64 服务器：dist/fantwo-core-linux-arm64
BINARY_PATH=dist/fantwo-core-linux-amd64

# 是否装 ffmpeg（video-compression 队列依赖；false 省约 176MB）
WITH_FFMPEG=true


# ==========================================================================
# 二、容器网络与端口
# ==========================================================================

# 本服务要加入的【已存在】Docker 网络，用于按容器名访问 PG/Redis/ES。
#
# 先查真实网络名：
#   docker inspect <PG容器名> --format '{{range $k,$v := .NetworkSettings.Networks}}{{$k}} {{end}}'
#
# ⚠️ 填错的后果：服务能启动，但报
#    hostname resolving error: lookup xxx on 127.0.0.11:53: no such host
EXTERNAL_NETWORK=1panel-network

# ---- 端口映射 ----
# 容器内监听端口（应用读 SERVER_PORT）
SERVER_PORT=3000
# 宿主机端口（1panel 面板常占 3000，可改 8079）
SERVER_BIND_PORT=8079
# 0.0.0.0 公网可访问 / 127.0.0.1 只本机走反代
APP_BIND_IP=0.0.0.0


# ==========================================================================
# 三、依赖服务地址（都在别的容器里）
# ==========================================================================

# ---- PostgreSQL ----
POSTGRES_HOST=1Panel-postgresql-Oyls
POSTGRES_PORT=5432
POSTGRES_USER=fantwo_core
POSTGRES_PASSWORD=change-this-db-password
POSTGRES_DATABASE=fantwo_core
POSTGRES_SSL_MODE=disable
POSTGRES_LOG_LEVEL=warn

# ---- Redis ----
REDIS_ADDR=1Panel-redis-Ohyl:6379
REDIS_PASSWORD=
REDIS_DB=0


# ==========================================================================
# 四、JWT（必填）
# ==========================================================================

# 生成：openssl rand -hex 32
JWT_SECRET=change-this-to-output-of-openssl-rand-hex-32
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=168h
JWT_ISSUER=fantwo-core


# ==========================================================================
# 五、运行时基础项
# ==========================================================================

SERVER_MODE=release
LOG_LEVEL=info
LOG_FORMAT=json
TZ=Asia/Shanghai
SWAGGER_ENABLED=false


# ==========================================================================
# 六、存储（仅 env，改了必须重启）
# ==========================================================================

# local（写 /app/uploads，挂命名卷）或 s3（对象存储）
STORAGE_DRIVER=local

# S3 七项【不迁 DB】：管理端写这些 key 会被 400 拒绝
# S3_ENDPOINT=
# S3_BUCKET=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_REGION=us-east-1
# S3_USE_SSL=false
# S3_FORCE_PATH_STYLE=true

# CDN 域名（DB 优先，可在管理端改，不用重启）
# CDN_BASE_URL=


# ==========================================================================
# 七、全文检索（ES 在另一个容器）
# ==========================================================================

# 没有 ES 就保持 false：/search 安全降级返回 5030，其它业务不受影响。
# 判断真实可用性看 GET /api/v1/search/status，不看开关字段。
SEARCH_ENABLED=true

# 必须填【真实存在】的 ES 容器名，绝不能填 127.0.0.1
SEARCH_ADDRESSES=http://1Panel-elasticsearch-B13p:9200

# SEARCH_USERNAME=
# SEARCH_PASSWORD=

SEARCH_ARTICLES_INDEX=picart_articles


# ==========================================================================
# 八、DB 优先的业务配置（env 仅兜底，改请走管理端接口）
# ==========================================================================

UPLOAD_MAX_IMAGE_MB=20
UPLOAD_MAX_VIDEO_MB=500
UPLOAD_MAX_AUDIO_MB=50
UPLOAD_MAX_OTHER_MB=100
UPLOAD_MAX_COUNT=10
UPLOAD_COMPRESSION_ENABLED=true
UPLOAD_WATERMARK_ENABLED=true

# 注意：STORAGE_LOCAL_DIR 不在本文件里 —— compose 固定为 /app/uploads（挂卷点）。


# ==========================================================================
# 九、纯 DB 配置 —— 没有对应的 env，只能走管理端接口
# ==========================================================================
#
# 站点信息：site_name / site_description / site_keywords / site_logo /
#   site_favicon / site_icp / site_police_record / site_mail / site_contact /
#   site_copyright（公开可读）
#
# 广告位：advertisement_enabled / advertisement_home_banner(+_link) /
#   advertisement_article_top(+_link) / advertisement_article_bottom(+_link) /
#   advertisement_article_sidebar(+_link) / advertisement_global_notice
#
# 水印细节：upload_watermark_text_template / _position / _opacity_percent /
#   _font_size / upload_thumbnail_specs（JSON 数组）
#
# 内容审核：content_audit_provider（none/tencent/aliyun）/ auto_block /
#   review_mode / sensitivity / {image,comment,avatar,article}_enabled
#   provider 凭据：tencent_secret_id / tencent_secret_key / tencent_region /
#   tencent_text_biz_type / tencent_image_biz_type /
#   aliyun_access_key_id / aliyun_access_key_secret / aliyun_region
#   ⚠️ 4 个凭据在管理端自动打码（value="***" + hasValue）
#
# 敏感词：用专用接口 POST/DELETE /api/v1/config/sensitive-words
