# =============================================================================
# fantwo-core 本地开发环境变量模板
# =============================================================================
#
# 用法：
#     cp .env.example .env          # 基础值（可提交，不含真实凭据）
#     cp .env.example .env.local    # 个人覆盖（gitignored，填真实密码/端口）
#
# 程序启动时会**显式加载**这两个文件（internal/config/env.go），无需 direnv /
# dotenv-cli / docker --env-file。
#
# 优先级（从低到高）：
#     内置默认值  <  config.yaml  <  .env  <  .env.local  <  真实进程环境变量
#
# 关键保证：`.env` **不覆盖**已存在的环境变量 —— 所以容器里
# `docker run -e POSTGRES_HOST=x` 永远压过镜像内的 .env。
# 只有 `.env.local` 会覆盖（它是开发机上的个人覆盖开关，生产不会有此文件）。
#
# 找不到 .env 不报错（生产用真实环境变量是常态）；语法错会打 WARN 但不阻断启动。
# =============================================================================

# ---------- 部署编排（docker compose 单服务模式） ----------
#
# 本项目 docker-compose.{build,binary}.yml **只跑 app 一个服务**，
# PostgreSQL / Redis / Elasticsearch 全部连**已有的外部容器**（1panel 装的或独立部署）。
#
# 上生产必须设的三个（写进服务器上的 .env）：
#
#   EXTERNAL_NETWORK   你的 PG/Redis/ES 容器所在的 docker 网络名
#                      1panel 装的默认是 1panel-network；独立部署常见 bridge / app-net
#                      用 `docker network ls` 查。app 加入该网络后可用**容器名**直连
#   CONTAINER_NAME     app 容器名（build/binary 两套默认名不同，避免互相抢名字）
#   BINARY_PATH        binary 模式下宿主机二进制的相对路径（默认 dist/fantwo-core-linux-amd64）
#
# 然后把下面三个 HOST 从 127.0.0.1 改成**容器名**（同一网络内 docker DNS 自动解析）：
#   POSTGRES_HOST=postgres                 # 或 1panel-xxx-postgres
#   REDIS_ADDR=redis:6379
#   SEARCH_ADDRESSES=http://elasticsearch:9200
#
# ⚠️ 不要把 PG/Redis/ES 写进本项目的 compose —— 它们由外部管理，本项目只负责连。
#    旧的「四服务」编排已废弃，备份在 tmp/compose-backup.yml（不进 git）。

EXTERNAL_NETWORK=1panel-network
CONTAINER_NAME=fantwo-core
BINARY_PATH=dist/fantwo-core-linux-amd64

# ---------- 服务 ----------
SERVER_PORT=3000
SERVER_MODE=debug          # debug | release
LOG_LEVEL=info
LOG_FORMAT=console         # console | json

# ---------- PostgreSQL ----------
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=         # 填真实密码（或写进 .env.local）
POSTGRES_DATABASE=fantwo_core
POSTGRES_SSL_MODE=disable

# ---------- Redis ----------
REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=
REDIS_DB=0

# ---------- JWT ----------
# 必须 >= 32 字符，否则签名器初始化失败
JWT_SECRET=change-me-to-a-32-plus-char-random-string
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=168h
JWT_ISSUER=fantwo-core

# ---------- Swagger ----------
# 生产不要开
SWAGGER_ENABLED=false

# ---------- 存储驱动（启动期只读，改了必须重启）----------
# local | s3
STORAGE_DRIVER=local
# S3 七项与 storage_driver 同属启动期配置，不落 DB
# S3_ENDPOINT=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_BUCKET=
# S3_REGION=
# S3_USE_SSL=

# ---------- 说明：其余配置走数据库 ----------
# 第三方登录凭据（微信/QQ/GitHub）、支付凭据、审核 provider、SMTP、短信、
# 上传限制、水印、搜索连接等**都存在 config 表**，通过管理端
# `PATCH /api/v1/config` 修改并即时生效，不走环境变量。
# 完整清单见 docs/05-配置项清单.md 与 docs/08-配置迁移运维手册.md。
