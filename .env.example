# 本地开发环境变量模板：cp .env.example .env 后按需修改
# 所有变量都可不设（走内置默认值），但 JWT_SECRET 在生产环境必须显式设置。

# ---- HTTP ----
SERVER_PORT=3000
SERVER_MODE=debug

# ---- PostgreSQL ----
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DATABASE=fantwo_core
POSTGRES_SSL_MODE=disable
POSTGRES_LOG_LEVEL=warn

# ---- Redis（缓存 / 权限版本 / 登出黑名单 / asynq 队列）----
REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=
REDIS_DB=0

# ---- JWT ----
# 生产务必替换为足够长的随机串（例如 openssl rand -hex 32）
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=168h
JWT_ISSUER=fantwo-core

# ---- 日志 ----
LOG_LEVEL=info
LOG_FORMAT=console

# ---- 存储（local 落本地盘；s3 走对象存储）----
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./uploads
# S3 兼容存储（MinIO / OSS / COS）
# S3_ENDPOINT=
# S3_BUCKET=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_REGION=us-east-1
# S3_USE_SSL=false
# 有 CDN 时填写，URL 会走 CDN 前缀；为空则走 /api/v1/uploads/<rel>
# CDN_BASE_URL=

# ---- 图片处理 ----
UPLOAD_MAX_IMAGE_MB=20
UPLOAD_MAX_VIDEO_MB=500
UPLOAD_COMPRESSION_ENABLED=true
UPLOAD_WATERMARK_ENABLED=true

# ---- 全文检索（不启用时 /search 返回 5030 安全降级）----
SEARCH_ENABLED=false
# 支持逗号分隔或 JSON 数组
SEARCH_ADDRESSES=http://127.0.0.1:9200
# 单值兜底（与上面取并集）
# SEARCH_ADDRESS=http://127.0.0.1:9200
SEARCH_ARTICLES_INDEX=picart_articles

# ---- Swagger（生产请关闭）----
SWAGGER_ENABLED=false
