# 本地开发环境变量模板：cp .env.example .env 后按需修改
# 所有变量都可不设（走内置默认值），但 JWT_SECRET 在生产环境必须显式设置。
#
# ╔══════════════════════════════════════════════════════════════════════════╗
# ║ 重要：业务配置已改为「数据库 config 表优先，env 只作兜底默认值」           ║
# ║                                                                          ║
# ║ 生效优先级：  DB config 表  →  本文件里的 env  →  代码内置默认值          ║
# ║                                                                          ║
# ║ 改「运行期配置」请用管理端接口，改完【不需要重启】：                      ║
# ║   PATCH /api/v1/config            body: [{"key":"...","value":"..."}]    ║
# ║   PATCH /api/v1/config/:id                                               ║
# ║   权限：setting:update                                                   ║
# ║                                                                          ║
# ║ 改下面标注「仅 env」的项，仍然必须【改 env + 重启服务】                   ║
# ║                                                                          ║
# ║ 运维操作详见 docs/08-配置迁移运维手册.md                                  ║
# ╚══════════════════════════════════════════════════════════════════════════╝
#
# 一个容易踩的坑：如果你改了某项 env 又重启，但 DB config 表里已有同名的行，
# 那么【DB 的值生效，你的 env 改动看不到效果】。先确认 DB 里有没有这一行。


# ==========================================================================
# 一、进程基础设施 —— 仅 env，改了必须重启（没有对应的 DB key）
# ==========================================================================

# ---- HTTP ----
SERVER_PORT=3000
SERVER_MODE=debug

# ---- PostgreSQL ----
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DATABASE=fantwo_core
POSTGRES_SSL_MODE=disable
POSTGRES_LOG_LEVEL=warn

# ---- Redis（缓存 / 权限版本 / 登出黑名单 / asynq 队列）----
REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=
REDIS_DB=0

# ---- JWT ----
# 生产务必替换为足够长的随机串（例如 openssl rand -hex 32）
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=168h
JWT_ISSUER=fantwo-core

# ---- 日志 ----
LOG_LEVEL=info
LOG_FORMAT=console

# ---- Swagger（生产请关闭）----
SWAGGER_ENABLED=false


# ==========================================================================
# 二、存储驱动与 S3 —— 仅 env，改了必须重启
#    这些【不迁 DB】：minio client 在启动期创建，改库不会重建连接。
#    管理端 POST/PATCH 写这些 key 会被 400 拒绝，避免库里留下永不生效的假配置。
# ==========================================================================

# local（写本地盘，默认）或 s3（minio-go，S3 兼容）
STORAGE_DRIVER=local

# S3 兼容存储（MinIO / AWS S3 / 阿里云 OSS / 腾讯云 COS）
# S3_ENDPOINT=
# S3_BUCKET=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_REGION=us-east-1
# S3_USE_SSL=false
# S3_FORCE_PATH_STYLE=true


# ==========================================================================
# 三、业务配置（DB 优先，env 仅兜底）—— 改这些请优先走管理端接口
#    下面每一项都标了对应的 DB key。env 只在「DB 里没有这一行 / 值为空」时生效。
# ==========================================================================

# ---- 本地存储目录（DB: storage_local_dir，默认 ./uploads）----
STORAGE_LOCAL_DIR=./uploads

# ---- CDN 域名（DB: cdn_base_url）----
# 有 CDN 时填写，URL 会走 CDN 前缀；为空则走 /api/v1/uploads/<rel>
# 注意：S3 的 CDN 同样用这一项（S3 自身的 endpoint/bucket 不走 DB）
# CDN_BASE_URL=

# ---- 上传上限（DB: upload_max_{image,video,audio,other}_size / upload_max_file_count）----
UPLOAD_MAX_IMAGE_MB=20
UPLOAD_MAX_VIDEO_MB=500
UPLOAD_MAX_AUDIO_MB=50
UPLOAD_MAX_OTHER_MB=100
UPLOAD_MAX_COUNT=10

# ---- 图片压缩（DB: upload_compression_enabled）----
# 关掉后：不生成缩略图、主图不重新编码；水印开关独立生效
UPLOAD_COMPRESSION_ENABLED=true

# ---- 水印（DB: upload_watermark_enabled，其余 4 项只能走管理端）----
UPLOAD_WATERMARK_ENABLED=true

# ---- 缩略图规格（DB: upload_thumbnail_specs，JSON 数组；env 无法表达复杂结构，改请走管理端）----
# 默认四档：thumb 200 / small 480 / medium 1024 / large 1920

# ---- 全文检索（DB: search_enabled / search_addresses / search_username / search_password / search_articles_index）----
# 注意：判断搜索是否真的可用，看 GET /api/v1/search/status，
#      不要看开关字段 —— 开关为 true 但地址为空时，服务仍视为未启用。
SEARCH_ENABLED=false
# 支持逗号分隔或 JSON 数组
SEARCH_ADDRESSES=http://127.0.0.1:9200
# 单值兜底（与上面取并集）
# SEARCH_ADDRESS=http://127.0.0.1:9200
# SEARCH_USERNAME=
# SEARCH_PASSWORD=
SEARCH_ARTICLES_INDEX=picart_articles


# ==========================================================================
# 四、纯 DB 配置 —— 没有对应的 env，只能走管理端接口
# ==========================================================================
#
# 站点信息（公开可读，GET /api/v1/config/public）
#   site_name / site_description / site_keywords / site_logo / site_favicon /
#   site_icp / site_police_record / site_mail / site_contact / site_copyright
#
# 广告位（公开可读，GET /api/v1/config/advertisement）
#   advertisement_enabled / advertisement_home_banner(+_link) /
#   advertisement_article_top(+_link) / advertisement_article_bottom(+_link) /
#   advertisement_article_sidebar(+_link) / advertisement_global_notice
#
# 水印细节（非公开）
#   upload_watermark_text_template（占位符 {nickname} {username} {site}）
#   upload_watermark_position（bottom-right/bottom-left/top-right/top-left/center）
#   upload_watermark_opacity_percent（0-100）
#   upload_watermark_font_size（0=按短边自适应）
#
# 内容审核（非公开）
#   content_audit_provider（none/tencent/aliyun）/ content_audit_auto_block /
#   content_audit_review_mode / content_audit_sensitivity /
#   content_audit_{image,comment,avatar,article}_enabled
#   provider 凭据：tencent_secret_id / tencent_secret_key / tencent_region /
#   tencent_text_biz_type / tencent_image_biz_type /
#   aliyun_access_key_id / aliyun_access_key_secret / aliyun_region
#   ⚠️ 其中 4 个凭据（tencent_secret_id / tencent_secret_key /
#      aliyun_access_key_id / aliyun_access_key_secret）在管理端【自动打码】：
#      GET 返回 value="***" + hasValue；PATCH 传空串或 "***" 表示不修改
#
# 敏感词（非公开，用专用接口管理）
#   POST   /api/v1/config/sensitive-words
#   DELETE /api/v1/config/sensitive-words
#   POST   /api/v1/config/sensitive-words/batch
