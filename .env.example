# 环境变量模板：cp .env.example .env 后按需修改
#
# ╔══════════════════════════════════════════════════════════════════════════╗
# ║ 本项目的 docker-compose.yml 只跑【一个服务】：fantwo-core（Go 二进制）      ║
# ║ PostgreSQL / Redis / Elasticsearch 都在【别的容器】里                      ║
# ║ （1panel 应用商店装的，或独立部署的），这里只负责连过去。                   ║
# ╚══════════════════════════════════════════════════════════════════════════╝
#
# ┌─ 容器间怎么填地址（最容易错的一节）──────────────────────────────────┐
# │ 容器里的 127.0.0.1 = 容器自己，永远连不到别的容器。                     │
# │                                                                       │
# │  PG/Redis/ES 在别的容器里，且与本服务同一 Docker 网络                   │
# │    → 填【容器名】：postgre / redis / 1Panel-elasticsearch-B13p         │
# │                                                                       │
# │  PG/Redis/ES 通过宿主机端口映射暴露                                     │
# │    → 填 host.docker.internal（compose 已配 extra_hosts）               │
# │                                                                       │
# │  在别的机器上                                                          │
# │    → 填那台机器的 IP                                                    │
# └───────────────────────────────────────────────────────────────────────┘
#
# ┌─ 配置改了什么时候生效 ────────────────────────────────────────────────┐
# │ 业务配置（上传上限 / 水印 / 搜索开关 / 审核…）已改为「DB config 表优先」  │
# │   改法：PATCH /api/v1/config   body: [{"key":"...","value":"..."}]      │
# │   生效：下一个请求（≤1 秒），【不用重启】                                │
# │   坑：改 .env 又重启，但 DB 里有同名行 → 看到的是 DB 值，env 不生效       │
# │                                                                       │
# │ 仅 env 的项（存储驱动 / S3 七项 / DB / Redis / JWT / 端口）              │
# │   改法：改 .env（或 1panel 编排的环境变量）→ 重建容器                    │
# │                                                                       │
# │ 详见 docs/08-配置迁移运维手册.md                                        │
# └───────────────────────────────────────────────────────────────────────┘


# ==========================================================================
# 一、容器网络接入方式（单服务编排必填）
# ==========================================================================

# 本服务要加入的【已存在】Docker 网络，用于按容器名访问 PG/Redis/ES。
#
# 先查真实网络名：
#   docker inspect <PG容器名> --format '{{range $k,$v := .NetworkSettings.Networks}}{{$k}} {{end}}'
#
# 1panel 装的容器通常在 1panel-network。
# 若 PG/Redis 走宿主机端口映射（不用容器名），留空这一行，
# 并把 POSTGRES_HOST / REDIS_ADDR 改成 host.docker.internal。
#
# ⚠️ 填了不存在的网络名，compose up 会报：
#    network xxx declared as external, but could not be found
EXTERNAL_NETWORK=1panel-network

# 宿主机对外端口（前面建议再套 Nginx / Caddy 做 TLS）
APP_PORT=3000


# ==========================================================================
# 二、依赖服务地址（都在别的容器里）
# ==========================================================================

# ---- PostgreSQL ----
# 容器名（同网络）或 host.docker.internal（宿主机端口）或 IP
POSTGRES_HOST=postgre
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-this-db-password
POSTGRES_DATABASE=fantwo_core
POSTGRES_SSL_MODE=disable
POSTGRES_LOG_LEVEL=warn

# ---- Redis ----
# 形如 容器名:6379 或 host.docker.internal:6379
REDIS_ADDR=redis:6379
REDIS_PASSWORD=
REDIS_DB=0


# ==========================================================================
# 三、JWT（必填）
# ==========================================================================

# 生成：openssl rand -hex 32
JWT_SECRET=change-this-to-output-of-openssl-rand-hex-32
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=168h
JWT_ISSUER=fantwo-core


# ==========================================================================
# 四、运行时基础项
# ==========================================================================

SERVER_MODE=release
LOG_LEVEL=info
LOG_FORMAT=json
# 时区：影响日志时间戳与「今日签到」等业务日期边界
TZ=Asia/Shanghai
# 生产请关闭
SWAGGER_ENABLED=false


# ==========================================================================
# 五、构建选项（影响 docker compose build）
# ==========================================================================

# from-source：编译在容器内进行（默认，宿主机不需要装 Go）
# from-binary：只 COPY 宿主机已有的 dist/ 二进制（秒级，需先交叉编译）
BUILD_TARGET=from-source

# from-binary 时的二进制路径
# BINARY_PATH=dist/fantwo-core-linux-amd64

# Go 模块代理（国内服务器必须，否则 go mod download 会卡死）
GOPROXY=https://goproxy.cn,direct

# 是否装 ffmpeg（video-compression 队列依赖；false 省约 176MB）
WITH_FFMPEG=true


# ==========================================================================
# 六、存储（仅 env，改了必须重启 —— minio client 在启动期创建）
# ==========================================================================

# local（写 /app/uploads，挂命名卷）或 s3（对象存储）
STORAGE_DRIVER=local

# S3 兼容存储（MinIO / AWS S3 / 阿里云 OSS / 腾讯云 COS）
# 这七项【不迁 DB】：管理端 POST/PATCH 写这些 key 会被 400 拒绝
# S3_ENDPOINT=
# S3_BUCKET=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_REGION=us-east-1
# S3_USE_SSL=false
# S3_FORCE_PATH_STYLE=true

# CDN 域名（这一项例外：DB 优先，可在管理端改，不用重启）
# CDN_BASE_URL=


# ==========================================================================
# 七、全文检索（ES 在另一个容器）
# ==========================================================================

# 判断搜索是否真的可用，看 GET /api/v1/search/status，
# 不要看开关字段 —— 开关 true 但没有地址时，服务仍视为未启用。
#
# 没有 ES 就保持 false：/search 会安全降级返回 5030，其它业务不受影响。
SEARCH_ENABLED=false

# ⚠️ 必须填【真实存在】的 ES 容器名（用 docker ps 查），绝不能填 127.0.0.1。
# 下面这行是示例，改成你自己的再取消注释：
# SEARCH_ADDRESSES=http://1panel-elasticsearch-B13p:9200
#
# 支持逗号分隔或 JSON 数组：
# SEARCH_ADDRESSES=http://es1:9200,http://es2:9200
# SEARCH_ADDRESSES=["http://es1:9200","http://es2:9200"]
SEARCH_ADDRESSES=

# 单值兜底（与上面取并集）
# SEARCH_ADDRESS=

# SEARCH_USERNAME=
# SEARCH_PASSWORD=

SEARCH_ARTICLES_INDEX=picart_articles


# ==========================================================================
# 八、DB 优先的业务配置（env 仅兜底，改请走管理端接口）
#     正常运维不需要动这一节
# ==========================================================================

# ---- 上传上限（DB: upload_max_{image,video,audio,other}_size / upload_max_file_count）----
UPLOAD_MAX_IMAGE_MB=20
UPLOAD_MAX_VIDEO_MB=500
UPLOAD_MAX_AUDIO_MB=50
UPLOAD_MAX_OTHER_MB=100
UPLOAD_MAX_COUNT=10

# ---- 图片压缩（DB: upload_compression_enabled）----
# 关掉后：不生成缩略图、主图不重新编码；水印开关独立生效
UPLOAD_COMPRESSION_ENABLED=true

# ---- 水印（DB: upload_watermark_enabled，其余 4 项只能走管理端）----
UPLOAD_WATERMARK_ENABLED=true

# ---- 本地存储目录（DB: storage_local_dir）----
# 容器内固定 /app/uploads（挂卷），一般不用改
STORAGE_LOCAL_DIR=/app/uploads


# ==========================================================================
# 九、纯 DB 配置 —— 没有对应的 env，只能走管理端接口
# ==========================================================================
#
# 站点信息（公开可读，GET /api/v1/config/public）
#   site_name / site_description / site_keywords / site_logo / site_favicon /
#   site_icp / site_police_record / site_mail / site_contact / site_copyright
#
# 广告位（公开可读，GET /api/v1/config/advertisement）
#   advertisement_enabled / advertisement_home_banner(+_link) /
#   advertisement_article_top(+_link) / advertisement_article_bottom(+_link) /
#   advertisement_article_sidebar(+_link) / advertisement_global_notice
#
# 水印细节（非公开）
#   upload_watermark_text_template（占位符 {nickname} {username} {site}）
#   upload_watermark_position（bottom-right/bottom-left/top-right/top-left/center）
#   upload_watermark_opacity_percent（0-100）
#   upload_watermark_font_size（0=按短边自适应）
#   upload_thumbnail_specs（JSON 数组，四档 thumb/small/medium/large）
#
# 内容审核（非公开）
#   content_audit_provider（none/tencent/aliyun）/ content_audit_auto_block /
#   content_audit_review_mode / content_audit_sensitivity /
#   content_audit_{image,comment,avatar,article}_enabled
#   provider 凭据：tencent_secret_id / tencent_secret_key / tencent_region /
#   tencent_text_biz_type / tencent_image_biz_type /
#   aliyun_access_key_id / aliyun_access_key_secret / aliyun_region
#   ⚠️ 其中 4 个凭据（tencent_secret_id / tencent_secret_key /
#      aliyun_access_key_id / aliyun_access_key_secret）在管理端【自动打码】：
#      GET 返回 value="***" + hasValue；PATCH 传空串或 "***" 表示不修改
#
# 敏感词（非公开，用专用接口管理）
#   POST   /api/v1/config/sensitive-words
#   DELETE /api/v1/config/sensitive-words
#   POST   /api/v1/config/sensitive-words/batch

# 注：本文件没有 APP_IMAGE —— compose 刻意不写 image 字段，
# 避免 1panel 先去 Docker Hub 拉一个不存在的镜像导致编排失败
# （详见 docker-compose.yml 里 app.build 上方的注释）。
