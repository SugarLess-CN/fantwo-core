# fantwo-core 测试服务器凭据模板（**只放占位符，不含真实值**）
#
# 用法：
#   cp .dsh/skills/fantwo-server-ops/server-creds.env.example tmp/server-creds.env
#   然后把 <尖括号> 换成真实值
#
# ⚠️ 填好的文件必须放 tmp/（已 gitignore）。本模板会随项目进 git，所以不含任何真实凭据。

# ---- SSH ----
SSH_HOST=<服务器地址>
SSH_USER=<用户名>
SSH_PASS=<密码>

# ---- 1Panel PostgreSQL（超管不叫 postgres，见 SKILL.md §三）----
PG_CONTAINER=1Panel-postgresql-Oyls
PG_USER=<数据库用户名>
PG_PASS=<数据库密码>
PG_DB=fantwo_core

# ---- 管理员测试账号 ----
ADMIN_ACCOUNT=<管理员账号>
ADMIN_PASSWORD=<管理员密码>
ADMIN_USER_ID=<管理员 user_id，UUID>
